generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String?
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  trades       Trade[]
  journals     TradingJournal[]
  sessions     Session[]
}

model AuthRateLimit {
  keyHash     String   @db.Char(64)
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([keyHash, windowStart])
  @@index([expiresAt])
}

model Trade {
  id          String    @id @default(cuid())
  userId      String
  pair        String    @db.VarChar(32)
  side        TradeSide
  entryPrice  Decimal   @db.Decimal(18, 8)
  exitPrice   Decimal?  @db.Decimal(18, 8)
  stopLoss    Decimal?  @db.Decimal(18, 8)
  takeProfit  Decimal?  @db.Decimal(18, 8)
  lotSize     Decimal   @db.Decimal(12, 4)
  pnl         Decimal?  @db.Decimal(18, 2)
  currency    String    @default("USD") @db.VarChar(3)
  strategyTag String?   @db.VarChar(80)
  externalId  String?   @db.VarChar(160)
  openedAt    DateTime
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId])
  @@index([userId, openedAt])
  @@index([userId, closedAt])
  @@index([userId, pair])
}

model TradingJournal {
  id           String   @id @default(cuid())
  userId       String
  entryDate    DateTime
  notes        String
  emotionScore Int?
  screenshots  String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryDate])
  @@index([userId, entryDate])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

enum TradeSide {
  BUY
  SELL
}

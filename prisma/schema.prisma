generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String           @id @default(cuid())
  email     String           @unique
  name      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  trades    Trade[]
  journals  TradingJournal[]
}

model Trade {
  id          String   @id @default(cuid())
  userId      String
  pair        String
  side        TradeSide
  entryPrice  Decimal  @db.Decimal(18, 8)
  exitPrice   Decimal? @db.Decimal(18, 8)
  lotSize     Decimal  @db.Decimal(12, 4)
  pnl         Decimal? @db.Decimal(18, 2)
  strategyTag String?
  openedAt    DateTime
  closedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, openedAt])
  @@index([userId, pair])
}

model TradingJournal {
  id           String   @id @default(cuid())
  userId       String
  entryDate    DateTime
  notes        String
  emotionScore Int?
  screenshots  String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryDate])
  @@index([userId, entryDate])
}

enum TradeSide {
  BUY
  SELL
}

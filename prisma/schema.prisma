generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  emailVerifiedAt DateTime?
  name         String?
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  trades       Trade[]
  journals     TradingJournal[]
  sessions     Session[]
  accountTokens AccountToken[]
  tradingAccounts TradingAccount[]
  brokerImports BrokerImport[]
  importedOrders ImportedOrder[]
}

model AuthRateLimit {
  keyHash     String   @db.Char(64)
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([keyHash, windowStart])
  @@index([expiresAt])
}

model Trade {
  id          String    @id @default(cuid())
  userId      String
  pair        String    @db.VarChar(32)
  side        TradeSide
  entryPrice  Decimal   @db.Decimal(18, 8)
  exitPrice   Decimal?  @db.Decimal(18, 8)
  stopLoss    Decimal?  @db.Decimal(18, 8)
  takeProfit  Decimal?  @db.Decimal(18, 8)
  lotSize     Decimal   @db.Decimal(12, 4)
  pnl         Decimal?  @db.Decimal(18, 2)
  currency    String    @default("USD") @db.VarChar(3)
  strategyTag String?   @db.VarChar(80)
  externalId  String?   @db.VarChar(160)
  brokerImportId String?
  sourcePositionId String? @db.VarChar(160)
  sourceOrderIds String[] @default([])
  brokerClosedPnl Decimal? @db.Decimal(18, 2)
  brokerNetPnl Decimal? @db.Decimal(18, 2)
  commission Decimal? @db.Decimal(18, 2)
  reconciliationDifference Decimal? @db.Decimal(18, 2)
  openedAt    DateTime
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerImport BrokerImport? @relation(fields: [brokerImportId], references: [id], onDelete: SetNull)

  @@unique([userId, externalId])
  @@unique([brokerImportId, sourcePositionId])
  @@index([userId, openedAt])
  @@index([userId, closedAt])
  @@index([userId, pair])
  @@index([brokerImportId])
}

model TradingJournal {
  id           String   @id @default(cuid())
  userId       String
  entryDate    DateTime
  notes        String
  emotionScore Int?
  screenshots  String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entryDate])
  @@index([userId, entryDate])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AccountToken {
  id        String             @id @default(cuid())
  userId    String
  tokenHash String             @unique @db.Char(64)
  purpose   AccountTokenPurpose
  expiresAt DateTime
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model TradingAccount {
  id              String          @id @default(cuid())
  userId          String
  name            String          @db.VarChar(80)
  baseCurrency    String          @default("USD") @db.Char(3)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerImports   BrokerImport[]
  importedOrders  ImportedOrder[]

  @@unique([userId, name])
  @@index([userId])
}

model BrokerImport {
  id              String          @id @default(cuid())
  userId          String
  accountId       String
  source          String          @db.VarChar(80)
  filename        String          @db.VarChar(255)
  timezone        String          @db.VarChar(80)
  summaryJson     Json?
  importedAt      DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         TradingAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  importedOrders  ImportedOrder[]
  trades          Trade[]

  @@index([userId, importedAt])
  @@index([accountId, importedAt])
}

model ImportedOrder {
  id              String          @id @default(cuid())
  userId          String
  accountId       String
  importId        String
  externalOrderId String          @db.VarChar(160)
  positionId      String?         @db.VarChar(160)
  symbol          String          @db.VarChar(32)
  side            String          @db.VarChar(16)
  type            String          @db.VarChar(32)
  status          String          @db.VarChar(16)
  qty             Decimal         @db.Decimal(12, 4)
  filledQty      Decimal         @db.Decimal(12, 4)
  limitPrice      Decimal?        @db.Decimal(18, 8)
  stopPrice       Decimal?        @db.Decimal(18, 8)
  avgFillPrice    Decimal?        @db.Decimal(18, 8)
  commission      Decimal?        @db.Decimal(18, 2)
  closedPnl       Decimal?        @db.Decimal(18, 2)
  netClosedPnl    Decimal?        @db.Decimal(18, 2)
  updateTimeUtc   DateTime
  rawJson         Json
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         TradingAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  import          BrokerImport    @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalOrderId])
  @@index([userId, updateTimeUtc])
  @@index([accountId, positionId])
  @@index([importId])
}

enum AccountTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum TradeSide {
  BUY
  SELL
}
